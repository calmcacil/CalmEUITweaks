{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ubuntu"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ]
}
