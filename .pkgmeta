package-as: CalmEUITweaks
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .release-please-manifest.json
  - release-please-config.json
  - renovate.json
  - VERSION
  - mise.toml
  - mise.lock
  - artifacts
  - AGENTS.md
  - SPEC.md
  - tests
  - scripts
  - docs
  - specs
